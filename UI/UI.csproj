<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <RootNamespace>Echotools.UI</RootNamespace>
    <AssemblyName>Echotools.UI</AssemblyName>
    <Version>1.0.0</Version>
    <Description>Shared UI components for Echotools Dalamud plugins</Description>
    <PackageProjectUrl>https://github.com/RenNagasaki/Echotools</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      KamiToolKit (latest) marks the tree-view nodes (TreeListNode,
      TreeListCategoryNode, ...) as [Experimental], which is an ERROR by default.
      The ScrollingTreeNode wrapper intentionally builds on them, so opt in to
      the experimental surface project-wide.
    -->
    <NoWarn>$(NoWarn);KamiToolKit_Experimental</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Remove="DalamudPackager" />
  </ItemGroup>

  <!--
    KamiToolKit: as a submodule inside a plugin (Plugin/Echotools/UI) the plugin's own
    KamiToolKit next to Echotools wins, so the plugin and UI share one copy. Standalone
    (this repo's own build and tests) the KamiToolKit submodule of this repo is used.
    Never both: two copies would give two incompatible KamiToolKit assemblies.
  -->
  <ItemGroup Condition="Exists('..\..\KamiToolKit\KamiToolKit.csproj')">
    <ProjectReference Include="..\..\KamiToolKit\KamiToolKit.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\KamiToolKit\KamiToolKit.csproj')">
    <ProjectReference Include="..\KamiToolKit\KamiToolKit.csproj" />
  </ItemGroup>

</Project>
